
<!-- Memanggil header -->
<%- include('../partials/header', { pageTitle: pageTitle }) %>

<section class="page-heading">
  <span class="eyebrow">KELOLA KOLEKSI</span>
  <h1>Edit Buku</h1>
  <p>Perbarui informasi buku di PustakaKita.</p>
</section>

<section class="card form-card">

  <form action="/katalog/edit/<%= buku.id_buku %>" method="POST">

    <!-- Judul Buku -->
    <div class="form-group">
      <label for="judul">Judul Buku</label>
      <input
        type="text"
        id="judul"
        name="judul"
        value="<%= buku.judul %>"
        required
      >
    </div>

    <!-- Penulis -->
    <div class="form-group">
      <label for="penulis">Penulis</label>
      <input
        type="text"
        id="penulis"
        name="penulis"
        value="<%= buku.penulis %>"
        required
      >
    </div>

    <!-- Tahun Terbit -->
    <div class="form-group">
      <label for="tahun_terbit">Tahun Terbit</label>
      <input
        type="number"
        id="tahun_terbit"
        name="tahun_terbit"
        min="1"
        max="2100"
        value="<%= buku.tahun_terbit %>"
        required
      >
    </div>

    <!-- Kategori Buku -->
    <div class="form-group">
      <label for="id_kategori">Kategori Buku</label>

      <select id="id_kategori" name="id_kategori" required>
        <% kategoriList.forEach(kategori => { %>
          <option
            value="<%= kategori.id_kategori %>"
            <%= buku.id_kategori === kategori.id_kategori ? 'selected' : '' %>
          >
            <%= kategori.nama_kategori %>
          </option>
        <% }); %>
      </select>
    </div>

    <!-- Tombol Simpan -->
    <button type="submit" class="button">
      Simpan Perubahan
    </button>

    <a href="/katalog" class="button-secondary">
      Batal
    </a>

  </form>
</section>

<!-- Memanggil footer -->
<%- include('../partials/footer') %>
